# Optional local client-form storage server. Public contact and inquiry email does not use this server.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATA_FILE=./server/data/submissions.json

# Public client settings embedded in the GitHub Pages bundle.
VITE_INQUIRY_API_URL=https://diamondpeo-webforms-api-chd0eed4hyhnemft.westus2-01.azurewebsites.net/api/send-inquiry
VITE_BASE_PATH=/
VITE_RECAPTCHA_SITE_KEY=
# Set to true only for full-stack hosting when the built client and local client-form API share an origin.
VITE_ENABLE_SAME_ORIGIN_API=true
